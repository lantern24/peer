{
  "name": "peer",
  "version": "0.4.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:core": "cargo test -p peer-core",
    "test:desktop": "wdio run tests/desktop/wdio.conf.ts",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "bundle": "tauri build --target aarch64-apple-darwin --bundles app",
    "bundle:dmg": "tauri build --target aarch64-apple-darwin --bundles app,dmg",
    "bundle:linux": "tauri build --bundles deb,appimage",
    "icons": "node scripts/generate-icons.mjs",
    "build:test-app": "node scripts/build-test-app.mjs",
    "format": "prettier --write src scripts tests *.json *.ts *.md && cargo fmt --all"
  },
  "dependencies": {
    "@pierre/diffs": "^1.5.2",
    "@shikijs/themes": "^3.13.0",
    "@tauri-apps/api": "~2.11.0",
    "@tauri-apps/plugin-clipboard-manager": "~2.3.0",
    "@tauri-apps/plugin-dialog": "~2.7.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "@wdio/tauri-plugin": "^1.4.0",
    "@wdio/tauri-service": "^1.4.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0",
    "webdriverio": "^9.32.0"
  },
  "engines": {
    "node": ">=22"
  }
}
